# Admin API 연결
ADMIN_API_URL=http://admin-api:8001

# 인증 (JWT 서명용)
NEXTAUTH_SECRET=change-me-in-production

# MVP 개발 인증 bypass (절대 프로덕션에서 true 설정 금지)
DEV_LOGIN_ENABLED=true

# OpenTelemetry
OTEL_SERVICE_NAME=admin-ui
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Next.js
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Tool Gateway (opt-in, published by provision_tool_gateway.sh deploy to deployment/tool-gateway/dashboard.generated.env)

# Public vars (browser, set to enable Tool Gateway dashboard)
NEXT_PUBLIC_TOOL_GATEWAY_ENABLED=false
# NEXT_PUBLIC_TOOL_GATEWAY_URL=https://...  # AgentCore Gateway HTTPS endpoint (from provision_tool_gateway.sh output: gateway_url)
# NEXT_PUBLIC_TOOL_GATEWAY_ID=...            # AgentCore Gateway ID (from provision_tool_gateway.sh output: gateway_id)
# NEXT_PUBLIC_TOOL_GATEWAY_REGION=us-east-1  # Always us-east-1 for AgentCore managed connectors

# Server-only vars (admin-ui server runtime, never prefixed NEXT_PUBLIC_)
# TOOL_GATEWAY_ARN=...                       # AgentCore Gateway ARN (from provision_tool_gateway.sh output: gateway_arn)
# COGNITO_TOOL_TOKEN_ENDPOINT=...            # Cognito M2M token endpoint (from provision_tool_gateway.sh output: cognito_domain_url + /oauth2/token)
# COGNITO_TOOL_M2M_CLIENT_ID=...             # Cognito M2M client ID (from provision_tool_gateway.sh output: auth_m2m_client_id)
# COGNITO_TOOL_M2M_CLIENT_SECRET=...         # Cognito M2M client secret (from provision_tool_gateway.sh output: auth_m2m_client_secret)
# COGNITO_TOOL_M2M_SCOPE=...                 # Cognito M2M scope (from provision_tool_gateway.sh output: auth_m2m_scope)
