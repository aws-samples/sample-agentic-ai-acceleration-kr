# Admin API 연결
ADMIN_API_URL=http://admin-api:8001

# 인증 (JWT 서명용)
NEXTAUTH_SECRET=change-me-in-production

# 개발용 로그인 (서명 없는 토큰 — 누구나 ADMIN 이 된다).
# DEV_LOGIN_ENABLED=true 이고 APP_ENV 가 개발 환경(dev / development / local / test)일 때만 열린다.
# APP_ENV 가 없으면 development 로 본다. 그 밖의 환경에서는 OIDC_* 로 SSO 를 설정한다.
APP_ENV=development
DEV_LOGIN_ENABLED=true

# OpenTelemetry
OTEL_SERVICE_NAME=admin-ui
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Next.js
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
