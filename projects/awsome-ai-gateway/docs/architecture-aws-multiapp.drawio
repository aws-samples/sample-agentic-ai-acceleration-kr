        <mxCell id="cowork-desktop" value="&lt;b&gt;Cowork (Claude desktop 3p)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5A6B86'&gt;anthropic-client-platform: desktop_app&lt;br&gt;originPinned → HTTPS 필수&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="220" height="64" as="geometry"/></mxCell>
        <mxCell id="gateway-cli" value="&lt;b&gt;gateway-cli (operator)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5A6B86'&gt;OIDC PKCE → Cognito Hosted UI&lt;br&gt;→ /v1/auth/exchange → Virtual Key&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="220" height="64" as="geometry"/></mxCell>
        <mxCell id="ext-note" value="클라이언트 판별: gateway-proxy ClientIdentificationMiddleware 가 Cowork(desktop_app)를 먼저 검사 → 아니면 claude-cli/ → claude-code. UA 는 신뢰하지 않음(분석용)." style="text;html=1;fontSize=9;align=left;verticalAlign=top;fontColor=#7D8998;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="690" width="240" height="100" as="geometry"/></mxCell>

