        <mxCell id="bi-aurora" value="Aurora (read-only)\nusage/auth/budget/model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="575" width="200" height="70" as="geometry" />
        </mxCell>
