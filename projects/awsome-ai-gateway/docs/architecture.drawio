        <mxCell id="sqlspec" value="② SQL Specialist (Sonnet 4.6)\ntext2SQL + 자체수정(3회)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="570" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="validator" value="③ SQL Validator (Opus 4.7)\n의미검증 5항목 → PASS/WARN/FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
