        <mxCell id="orch" value="① Orchestrator (Opus 4.7)\n의도분류·위임·최종응답\ndeterministic-tool-first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
