        <!-- ===================== BI 5-AGENT (lane) ===================== -->
        <mxCell id="bi-lane" value="AI BI 어시스턴트 — Bedrock AgentCore Runtime (5-agent Strands)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
