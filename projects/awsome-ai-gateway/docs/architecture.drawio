<mxfile host="app.diagrams.net" type="device">
  <diagram name="LLM-Gateway-Architecture" id="llm-gateway-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="LLM Gateway — Architecture (AWS EKS Fargate, ap-northeast-2)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry" />
        </mxCell>

        <!-- ===================== DATA PLANE (lane) ===================== -->
        <mxCell id="dp-lane" value="DATA PLANE — 사용자 LLM 요청 (gateway-proxy)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="800" height="430" as="geometry" />
        </mxCell>
        <mxCell id="cc" value="Claude Code\n(api-key-helper)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="gateway-cli\nlogin (OIDC PKCE) →\nVK 자동 발급" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gwproxy" value="gateway-proxy (FastAPI)\nVK 인증 → 예산 → Rate Limit\n→ 모델접근제어 → 다운그레이드\n→ Bedrock 프록시 → 비용추적\n(SSE 스트리밍)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="AWS Bedrock\n(Claude Opus/Sonnet/Haiku\nglobal.* cross-region)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="590" y="135" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dp-redis" value="ElastiCache (Valkey)\nVK캐시·RPM/TPM·예산상태\ncost:stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="320" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dp-aurora" value="Aurora PostgreSQL\nauth/usage/budget/model\n(usage_logs, virtual_keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="320" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="costworker" value="cost-recorder-worker\ncost:stream → usage_logs\n+ 일일 집계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="420" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="notifworker" value="notification-worker\n예산 임계 알림" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="420" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- DP edges -->
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="cc" target="gwproxy"><mxGeometry relative="1" as="geometry" /></mxCell>
