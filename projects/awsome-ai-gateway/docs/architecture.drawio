        <mxCell id="harness" value="정확도 하네스\n· 구조화 envelope (JSON only)\n· reconciliation gate (숫자 검증)\n· tool 투명성 (tool_call/result)\n· golden test 17→33→50→67%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1230" y="575" width="280" height="150" as="geometry" />
