          <mxGeometry x="70" y="730" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="querydb" value="query_db Lambda\nsqlglot AST 검증 + 화이트리스트\n+ EXPLAIN cost + LIMIT + 10s\nread-only (gateway_chat_reader)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="565" width="240" height="90" as="geometry" />
