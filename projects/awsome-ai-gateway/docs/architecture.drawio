        <mxCell id="adminapi" value="admin-api (FastAPI)\nVK발급·CRUD(사용자/팀/모델/\n예산/RateLimit)·분석·ROI\nCognito JWT (ADMIN/TEAM_LEADER)\n/admin/chat/* (BI proxy, SigV4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
