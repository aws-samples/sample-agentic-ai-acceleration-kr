# semantic-layer 실행에 필요한 환경변수 예시.
# 실제 값으로 채워 .env 로 복사(.env 는 커밋 금지).

# --- 공통 ---
AWS_REGION=us-west-2

# --- seed-semantic (seed_semantic.py) ---
# DynamoDB system-of-record 테이블명 (CDK semantic 스택 output 에서 획득).
SEMANTIC_TABLE_NAME=agentic-t2sql-semantic
# 임베딩 모델(term/fewshot 쓰기 시점에 Titan v2 로 계산).
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- graph_sync Lambda (lambda_handler.py) ---
# Neptune openCypher 엔드포인트(https://<host>:8182). Lambda 환경변수로 주입된다.
GRAPH_ENDPOINT=https://agentic-t2sql-graph.cluster-xxxx.us-west-2.neptune.amazonaws.com:8182
