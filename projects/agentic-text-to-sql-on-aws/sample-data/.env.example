# sample-data 실행에 필요한 환경변수 예시.
# 실제 값으로 채워 .env 로 복사(.env 는 커밋 금지).

# --- 공통 ---
AWS_REGION=us-west-2

# --- Aurora seed (seed_aurora.py) ---
# 값은 CDK base 스택 output(base-outputs.json)에서 가져온다.
# Aurora PostgreSQL 클러스터 ARN (RDS Data API 대상)
AURORA_CLUSTER_ARN=arn:aws:rds:us-west-2:000000000000:cluster:agentic-t2sql-aurora
# 클러스터 master 자격증명 시크릿 ARN (스키마/데이터 적재, 역할 생성에 사용)
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:agentic-t2sql/aurora/master-XXXXXX
# CDK 가 관리하는 agent_ro read-only 시크릿 ARN (= SQL MCP 의 AURORA_SECRET_ARN).
# 이 값을 주면 seed 가 이 비밀번호로 agent_ro DB 역할을 동기화한다(자격증명 정합 필수).
AGENT_RO_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:agentic-t2sql/aurora/agent_ro-XXXXXX
# 대상 데이터베이스명
DB_NAME=ecommerce
# (선택) agent_ro 시크릿에 기록할 클러스터 엔드포인트 host
# AURORA_HOST=agentic-t2sql-aurora.cluster-xxxx.us-west-2.rds.amazonaws.com

# --- OpenSearch 인덱싱 (index_schema_docs.py) ---
# OpenSearch 도메인 엔드포인트 (https:// 포함/미포함 모두 허용)
OPENSEARCH_ENDPOINT=https://search-agentic-t2sql-xxxx.us-west-2.es.amazonaws.com
OPENSEARCH_INDEX=t2sql-schema-docs
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
