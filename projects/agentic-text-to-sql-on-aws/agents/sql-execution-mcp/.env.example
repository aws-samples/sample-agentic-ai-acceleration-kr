# sql-execution-mcp 환경 변수 (실물 .env는 커밋 금지)
# read-only(agent_ro) 자격증명만 사용 — READ-ONLY 다층 방어의 최후 방어선.
# 값은 CDK base 스택 output(base-outputs.json)에서 가져온다.
AURORA_CLUSTER_ARN=arn:aws:rds:us-west-2:000000000000:cluster:agentic-t2sql-aurora
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:agentic-t2sql/aurora/agent_ro-XXXXXX
DB_NAME=ecommerce
AWS_REGION=us-west-2
