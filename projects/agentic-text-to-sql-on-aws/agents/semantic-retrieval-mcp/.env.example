# semantic-retrieval-mcp 환경 변수 (실물 .env는 커밋 금지)
# 값은 CDK base 스택 output(base-outputs.json)에서 가져온다.
OPENSEARCH_ENDPOINT=https://search-agentic-t2sql-search-xxxxxxxx.us-west-2.es.amazonaws.com
OPENSEARCH_INDEX=t2sql-schema-docs
# 용어/few-shot 인덱스. 설정 시 스키마+용어/few-shot 결합(Composite) 조립.
SEMANTIC_INDEX=t2sql-semantic
OPENSEARCH_SEARCH_PIPELINE=t2sql-hybrid-pipeline
# SigV4 서명 서비스명. 이 솔루션은 관리형 OpenSearch 도메인이라 es(기본).
# OpenSearch Serverless 로 바꾸면 aoss.
OPENSEARCH_SERVICE=es
# Neptune join-path 순회. 미배포 환경에선 false 로 두면 OpenSearch 단독으로 graceful degrade.
SEMANTIC_GRAPH_ENABLED=false
# graph 활성 시 필수 — Neptune 엔드포인트(https://<host>:8182).
GRAPH_ENDPOINT=https://agentic-t2sql-graph-xxxxxxxx.us-west-2.neptune.amazonaws.com:8182
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_REGION=us-west-2
