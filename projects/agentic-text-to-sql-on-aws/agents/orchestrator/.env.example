# 오케스트레이터 에이전트 환경 변수 (예시).
# 실제 값은 .env 로 복사해 채우고, .env 는 커밋하지 않는다.

# AgentCore Runtime 에 호스팅된 MCP 서버 ARN 2개 (Task #3 산출물, CDK output).
SQL_MCP_ARN=arn:aws:bedrock-agentcore:us-west-2:000000000000:runtime/sql-execution-mcp-XXXX
SEMANTIC_MCP_ARN=arn:aws:bedrock-agentcore:us-west-2:000000000000:runtime/semantic-retrieval-mcp-XXXX

# AgentCore Memory (STM) ID. 비우면 메모리 비활성으로 동작.
MEMORY_ID=

# Bedrock Claude inference profile (기본: us.anthropic.claude-sonnet-5).
MODEL_ID=us.anthropic.claude-sonnet-5

# AWS 리전.
AWS_REGION=us-west-2

# self-correction 최대 재시도 횟수 (기본 3).
MAX_SQL_CORRECTIONS=3

# 실행 모드: graph(기본, Strands Graph) | agent(단일 Agent 폴백).
ORCHESTRATOR_MODE=graph

# ── 도구 평면(tool plane) 모드 ───────────────────────────────────────────────
# direct(기본): 위 SQL_MCP_ARN/SEMANTIC_MCP_ARN 로 Runtime MCP 서버에 직접(SigV4) 연결.
# gateway: 단일 Gateway MCP 엔드포인트가 모든 도구를 집약. 아래 GATEWAY_URL + Cognito M2M 필요.
TOOL_PLANE_MODE=direct

# gateway 모드 전용 — Gateway MCP URL (CDK output: agentic-t2sql-gateway-url).
GATEWAY_URL=

# gateway 모드 전용 — Cognito M2M(USER_PASSWORD_AUTH) 인증.
# 비밀번호는 평문 env 가 아니라 Secrets Manager ARN 으로만 전달한다.
COGNITO_CLIENT_ID=
COGNITO_USER=
COGNITO_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:agentic-t2sql/cognito/agent-XXXX
COGNITO_USER_POOL_ID=

# ── 개선 파이프라인 (활성 Configuration Bundle) ──────────────────────────────
# 활성 bundle 포인터를 담은 SSM 파라미터 이름. 비우면 기능 비활성(코드 기본값 사용).
# 값 형식: {"bundleId":"...","versionId":"..."}
CONFIG_BUNDLE_PARAM=

# 구조화 로그(t2sql_query_record)의 version.agent 로 남길 앱 버전 라벨 (기본 dev).
APP_VERSION=dev
