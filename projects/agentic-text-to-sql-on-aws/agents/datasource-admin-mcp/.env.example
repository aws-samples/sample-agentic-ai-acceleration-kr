# datasource-admin-mcp 환경 변수 (실물 .env는 커밋 금지)
# 값은 CDK 스택 output(base-outputs.json / semantic-outputs.json)에서 가져온다.
AWS_REGION=us-west-2

# semantic system-of-record (DynamoDB 단일 쓰기 지점)
SEMANTIC_TABLE_NAME=agentic-t2sql-semantic
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# 스키마 크롤 대상 — Aurora (read-only agent_ro 자격증명만 사용)
AURORA_CLUSTER_ARN=arn:aws:rds:us-west-2:000000000000:cluster:agentic-t2sql-aurora
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:agentic-t2sql/aurora/agent_ro-XXXXXX
DB_NAME=ecommerce

# 스키마 크롤 대상 — Redshift Serverless (SecretArn 필수: 없으면 IAM 매핑 사용자로 실행됨)
REDSHIFT_WORKGROUP=agentic-t2sql-rs-wg
REDSHIFT_DB=analytics
REDSHIFT_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:agentic-t2sql/redshift/agent_ro-XXXXXX

# 등록 데이터소스 연결 설정 시크릿 prefix
DATASOURCE_SECRET_PREFIX=agentic-t2sql/datasource/
