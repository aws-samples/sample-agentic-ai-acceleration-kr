{
  "app": "npx ts-node --prefer-ts-exts bin/agentic-t2sql.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "dist"
    ]
  },
  "context": {
    "appPrefix": "agentic-t2sql",
    "region": "us-west-2",
    "dbName": "ecommerce",
    "readOnlyDbUser": "agent_ro",
    "openSearchIndex": "t2sql-schema-docs",
    "embeddingModelId": "amazon.titan-embed-text-v2:0",
    "modelId": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "ecrRepos": {
      "orchestrator": "agentic-t2sql/orchestrator",
      "sqlExecutionMcp": "agentic-t2sql/sql-execution-mcp",
      "semanticRetrievalMcp": "agentic-t2sql/semantic-retrieval-mcp",
      "ui": "agentic-t2sql/ui"
    },
    "semanticTableName": "agentic-t2sql-semantic",
    "semanticIndex": "t2sql-semantic",
    "graphMinNcu": 1,
    "graphMaxNcu": 2.5,
    "gatewayName": "agentic-t2sql-gateway",
    "policyEngineName": "agentic_t2sql_policy_engine",
    "sqlTargetName": "sql-execution-mcp",
    "semanticTargetName": "semantic-retrieval-mcp",
    "toolPlaneMode": "direct",
    "gatewayUrl": "",
    "redshiftNamespaceName": "agentic-t2sql-rs-ns",
    "redshiftWorkgroupName": "agentic-t2sql-rs-wg",
    "redshiftBaseCapacity": 4,
    "redshiftRoSecretName": "agentic-t2sql/redshift/agent_ro",
    "exEvaluatorFunctionName": "agentic-t2sql-ex-evaluator",
    "executionEvaluatorName": "agentic_t2sql_execution_accuracy",
    "onlineEvalConfigName": "agentic_t2sql_online_eval",
    "evalExecutionRoleName": "agentic-t2sql-eval-exec-role",
    "activeBundleParamName": "/agentic-t2sql/active-bundle",
    "configBundleName": "agentic_t2sql_orchestrator",
    "evaluatorVersion": "1.0.0",
    "onlineEvalSamplingPercentage": 100,
    "appVersion": "m5",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk-containers/ecs-service-extensions:enableDefaultLogDriver": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-codepipeline:crossAccountKeyAliasStackSafeResourceName": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-rds:databaseProxyUniqueResourceName": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentControllerForCircuitBreaker": true,
    "@aws-cdk/aws-ecs:removeDefaultDeploymentAlarm": true,
    "@aws-cdk/aws-opensearchservice:enableOpensearchMultiAzWithStandby": false
  }
}
