# ============================================================================
# agentic-text-to-sql UI — 환경 변수 예시
# 실제 값은 .env.local 에 복사해 사용하세요 (.env* 파일은 커밋 금지).
# ============================================================================

# AgentCore Runtime ARN — 오케스트레이터 에이전트가 배포된 Runtime ARN.
# 프록시가 URL 인코딩해 /invocations 엔드포인트를 구성합니다.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:000000000000:runtime/agentic_text_to_sql-XXXXXXXXXX

# AWS 리전 (설계 확정: us-west-2)
AWS_REGION=us-west-2

# Runtime 호출 시 사용할 qualifier (기본: DEFAULT). 필요 시 버전/엔드포인트로 변경.
AGENT_RUNTIME_QUALIFIER=DEFAULT

# 사용자 식별자(forwardedProps.actorId) — AgentCore Memory 사용자 격리 근거.
# M1 은 고정값, M3 에서 Cognito sub 로 교체(프록시 인증 훅 참조).
AGENT_ACTOR_ID=demo-user

# ----------------------------------------------------------------------------
# AWS 자격증명
# ----------------------------------------------------------------------------
# ECS 배포 시: 자격증명을 설정하지 않습니다. Task Role(SigV4)을 자동 사용합니다.
# 로컬 개발 시: 아래 중 하나를 사용합니다.
#   1) AWS_PROFILE 로 프로파일 지정 (권장)
#   2) AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN 직접 지정
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# 이벤트 어댑터 선택 (M1 스파이크용)
# ----------------------------------------------------------------------------
# 'agui'      : AGUIApp 표준 AG-UI SSE 이벤트를 그대로 사용 (기본)
# 'raw-sse'   : 오케스트레이터가 자체 SSE 포맷을 낼 때의 폴백 어댑터
#               (lib/agui-adapter.ts 참조 — 이 값만 바꾸면 파싱 레이어 교체)
AGUI_ADAPTER=agui

# ----------------------------------------------------------------------------
# Next.js
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
