# ============================================================================
# agentic-text-to-sql Admin Panel — 환경 변수 예시
# 실제 값은 .env.local 에 복사해 사용하세요 (.env* 파일은 커밋 금지).
# 값 출처: infra 배포 산출물(base-outputs.json / gateway-outputs.json).
# ============================================================================

# AWS 리전 (설계 확정: us-west-2)
AWS_REGION=us-west-2

# ----------------------------------------------------------------------------
# Cognito — 로그인(USER_PASSWORD_AUTH) · AccessToken 검증(aws-jwt-verify)
# ----------------------------------------------------------------------------
# 사용자 풀 ID (base 스택 출력 UserPoolId)
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX

# USER_PASSWORD_AUTH 가 활성화된 클라이언트 ID
# (base 스택 출력 agentic-t2sql-m2m-client-id — M4 admin 로그인 겸용)
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ----------------------------------------------------------------------------
# Gateway MCP — semantic 쓰기/데이터소스 작업의 단일 경로 (사용자 JWT On-Behalf-Of)
# ----------------------------------------------------------------------------
# gateway 스택 출력 agentic-t2sql-gateway-url (…/mcp 로 끝나는 MCP 엔드포인트)
GATEWAY_URL=https://agentic-t2sql-gateway-XXXXXXXXXX.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp

# Gateway MCP target 이름 — 도구명 프리픽스(`<target>___<tool>`) 구성에 사용.
# 기본값 datasource-admin-mcp (§8.2). 통상 변경하지 않습니다.
# ADMIN_MCP_TARGET=datasource-admin-mcp

# ----------------------------------------------------------------------------
# Cedar 정책 조회 (read-only)
# ----------------------------------------------------------------------------
# gateway 스택 출력 PolicyEngineId
POLICY_ENGINE_ID=XXXXXXXXXX

# ----------------------------------------------------------------------------
# 트레이스 탐색기 — AgentCore Runtime 로그 그룹 프리픽스
# ----------------------------------------------------------------------------
RUNTIME_LOG_GROUP_PREFIX=/aws/bedrock-agentcore/runtimes/

# ----------------------------------------------------------------------------
# M5 — 평가·개선 화면 (§9.7). 전부 optional: 미설정이면 화면에 "미구성" 안내만 뜨고
# 기존 화면·헬스체크는 영향을 받지 않습니다 (evaluation 스택 미배포 환경 대응).
# ----------------------------------------------------------------------------
# 커스텀 EX(Execution Accuracy) 평가자 ID — evaluation 스택 출력 ExecutionEvaluatorId
# EXECUTION_EVALUATOR_ID=

# 온라인 평가 구성 ID — evaluation 스택 출력 OnlineEvalConfigId
# ONLINE_EVAL_CONFIG_ID=

# 활성 config bundle 포인터 SSM 파라미터 이름 (기본값 사용 권장)
# ACTIVE_BUNDLE_PARAM=/agentic-t2sql/active-bundle

# 배치 평가·추천의 트레이스 소스 (orchestrator runtime 로그 그룹 / 서비스 이름)
# ORCHESTRATOR_LOG_GROUP=/aws/bedrock-agentcore/runtimes/agentic_t2sql_orchestrator-XXXXXXXXXX-DEFAULT
# ORCHESTRATOR_SERVICE_NAME=agentic_t2sql_orchestrator

# 배치 평가 실행 role ARN — evaluation 스택 출력 EvalExecutionRoleArn
# EVAL_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/agentic-t2sql-eval-execution

# ----------------------------------------------------------------------------
# AWS 자격증명
# ----------------------------------------------------------------------------
# ECS 배포 시: 자격증명을 설정하지 않습니다. Task Role 을 자동 사용합니다.
# 로컬 개발 시: 아래 중 하나를 사용합니다.
#   1) AWS_PROFILE 로 프로파일 지정 (권장)
#   2) AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN 직접 지정
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# Next.js
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
