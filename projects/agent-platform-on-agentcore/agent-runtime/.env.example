# Bedrock Model Configuration
MODEL_ID=global.anthropic.claude-sonnet-5-5
REGION_NAME=ap-northeast-1

# Agent Configuration
# Which sample agent this deployment runs. See agents/__init__.py AGENT_REGISTRY.
#   default       - single agent: MCP gateway tools (incl. web search) + artifact tools
AGENT_MODULE=default

# Agent name used for deployment. Leave unset to auto-derive as bap_<module>
# ("bap" = bedrock agent platform), so each sample deploys as its own runtime.
# Setting it pins every module to one runtime, so the next deploy overwrites
# whichever sample was there before.
# AGENT_NAME=bap_my_agent

# Bedrock Guardrail (Optional)
# Applies a Bedrock Guardrail to every model call so input/output are filtered
# (content filters, PII, etc. — configured on the guardrail itself in the console).
# Leave GUARDRAIL_ID empty to run without any guardrail. GUARDRAIL_VERSION
# defaults to DRAFT; set a published version number to pin one.
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT

# Long-term (session-summary) recall (Optional). Set true only for runtimes
# whose AgentCore Memory has a SUMMARIZATION strategy (bap_default). Off by
# default; safe to leave unset for other runtimes.
# LONG_TERM_RECALL=false

# MCP Gateway (Optional)
# Leave empty to run with local tools only. The platform gateway uses AWS_IAM, so
# the runtime signs requests with its execution role (auth/sigv4.py); no token or
# Cognito values are needed. deploy.sh autofills this from the deployed stack's
# Terraform outputs when left empty (infra/envs/standalone by default). Set
# AUTO_TF_OUTPUTS=false to disable that, or INFRA_ENV_DIR=<path> to point at a
# different stack. An explicit value here always wins over the autofill.
MCP_GATEWAY_URL=

# Execution role for the runtime (Optional). The stack creates one that already
# has InvokeGateway on the platform gateway:
#   cd infra/envs/standalone && terraform output -raw agent_runtime_role_arn
# Left empty, `agentcore configure` creates a role of its own.
# EXECUTION_ROLE=

# AgentCore Memory (Optional). Empty means no memory: the hook is not attached.
# bap_conversations_default is created by the installer or by hand (DEPLOYMENT.md).
# MEMORY_ID=

# Model behaviour (Optional)
# REASONING_BUDGET=0      # extended-thinking budget in tokens; 0 = off
# MAX_TOKENS=8192         # output ceiling per model call
# PROMPT_CACHE=true       # cache the static prefix (system prompt + tool schemas)

# Agent Registry Registration (Optional)
# Platform endpoint that owns the Agent Registry. When set, deploy.sh registers
# the deployed runtime there so it shows up in the Registry UI. Leave empty to
# skip and register manually from the Registry page ("Sync deployed").
#   local:      http://localhost:8000
#   deployed:   the ALB URL from `cd infra/envs/standalone && terraform output alb_url`
#               (ECS only exposes the web service; it proxies /api to the server)
PLATFORM_API_URL=

# Admin account deploy.sh signs in with to register the runtime (3단계 admin_email).
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_PASSWORD=

# Set to true to skip registration even when PLATFORM_API_URL is set.
# SKIP_REGISTRY_SYNC=false
