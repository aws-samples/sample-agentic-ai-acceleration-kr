# AWS Configuration
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB Table Names
DYNAMODB_THREADS_TABLE=bap-threads
DYNAMODB_ASSISTANTS_TABLE=langgraph-assistants

# Bedrock Model Configuration (default model for harness composition)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5

# Runtime agent that answers chats whose registry record carries no ARN; the
# record pointing at it is the default agent the picker pins to the top. Empty
# until `agent-runtime/scripts/deploy.sh` has deployed one.
AGENT_RUNTIME_ARN=

# Models a per-thread override may pick, for every agent (runtime or harness).
# Comma-separated inference-profile ids, picker order; a team's list can only
# narrow this one. Empty = no model override is offered. Claude 5 needs the
# global.* profile ids — foundation-model ids are rejected by ConverseStream
# (on-demand throughput ValidationException).
# ALLOWED_MODELS=global.anthropic.claude-sonnet-5-5,global.anthropic.claude-opus-5-5,global.anthropic.claude-haiku-5-5

# AgentCore Agent Registry. Created by infra/modules/agent_registry:
#   cd infra/envs/standalone && terraform output agent_registry_id
# Unset -> the registry is off: records, chat and harness composition fall back
# to the deployed AgentCore resources themselves (see AP_USE_REGISTRY).
AGENT_REGISTRY_ID=
# auto (default): registry on when AGENT_REGISTRY_ID is set. 0/false: force off
# even with an id. A configured registry that answers with an AWS error (SCP,
# retired namespace, outage) degrades to the same deployed-resource fallback.
# AP_USE_REGISTRY=auto

# Extra regions whose AgentCore runtimes are also offered when registering an
# agent (comma-separated). Empty = this region only. Invocation always targets
# the region in the runtime ARN, so a Seoul agent stays a Seoul invoke.
# AGENT_RUNTIME_DISCOVERY_REGIONS=ap-northeast-2

# Agent artifacts rendered in the chat side panel. Created by
# infra/modules/s3_artifacts and infra/modules/dynamodb:
#   cd infra/envs/standalone && terraform output artifacts_bucket artifacts_table
# Unset -> artifacts still stream to the UI but are not persisted or shareable.
ARTIFACTS_BUCKET=
ARTIFACTS_TABLE=

# Per-turn usage rollup table (terraform output usage_table_name)
USAGE_TABLE=

# Harness output sweep. A harness runs its tools inside AWS, so a file it produces
# stays in its sandbox; the server collects it after the turn. See
# services/harness_output_service.py for details.
# Unset means the feature is off, matching how artifact storage reports itself as unconfigured.
HARNESS_OUTPUT_SWEEP=true
HARNESS_OUTPUT_ROOTS=/home
# Only "output-shaped" files. Without this, helper scripts (.py, .xml, etc.)
# land in the panel as artifacts.
HARNESS_OUTPUT_EXTENSIONS=docx,xlsx,pptx,pdf,csv,md,html,png,jpg,svg,zip
HARNESS_OUTPUT_MAX_FILE_BYTES=52428800
HARNESS_OUTPUT_MAX_FILES=10
HARNESS_OUTPUT_COMMAND_TIMEOUT=60

# Where the built-in-tools gateway writes browser screenshots, so the chat can
# re-render one after the Lambda's presigned URL expires. Not a Terraform resource
# — infra/builtin_tools_gateway/deploy.py creates it and prints it as
# "screenshot_bucket" on `up` (named "<project>-builtin-tools-<account>").
# Unset -> a screenshot stops loading an hour after it was taken.
BROWSER_SCREENSHOT_BUCKET=

# Knowledge bases. Created by infra/modules/s3_knowledge, knowledge_roles and
# dynamodb:
#   cd infra/envs/standalone && terraform output knowledge_bucket knowledge_table
# All four unset -> /api/knowledge answers 501; any one missing keeps it there.
KNOWLEDGE_BUCKET=
KNOWLEDGE_TABLE=
KB_SERVICE_ROLE_ARN=
KB_GATEWAY_ROLE_ARN=
# Admin-attachable external buckets. Unset -> admins can only use the platform bucket.
KNOWLEDGE_SOURCE_BUCKETS=
# The stack's own kb-source bucket (terraform output; also present in
# KNOWLEDGE_SOURCE_BUCKETS so the kb-service role can read it). Managed S3
# knowledge bases keep per-user folders here and the server writes site
# uploads into them. Unset -> ordinary users cannot create S3-backed
# knowledge bases; admin-attached external buckets still work.
KNOWLEDGE_PLATFORM_SOURCE_BUCKET=

# Cognito User Authentication (app login)
# App client used for USER_PASSWORD_AUTH must have that flow enabled.
COGNITO_USER_POOL_CLIENT_ID=your_app_client_id
COGNITO_REGION=ap-northeast-1
# Only set if the app client has a secret configured (enables SECRET_HASH):
# COGNITO_CLIENT_SECRET=your_app_client_secret
# User pool id, needed to verify access tokens on the server side.
COGNITO_USER_POOL_ID=your_user_pool_id
# Local-only escape hatch: skips token verification when the pool above is
# unset. Never set this in a deployed environment.
AUTH_ENFORCED=false

# Microsoft Entra ID login (optional, alongside or instead of Cognito).
# The browser does Authorization Code + PKCE; the server verifies the id_token.
# Terraform injects OIDC_PROVIDERS_JSON instead; these flat variables are for
# a local .env. Register http://localhost:3000/auth/callback on the Entra app.
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<application-client-id>
# OIDC_AUDIENCE=<application-client-id>
# OIDC_REDIRECT_URIS=http://localhost:3000/auth/callback
# OIDC_ADMIN_GROUPS=PlatformAdmin
# OIDC_REQUIRED_GROUP=
# Entra sign-ins are recorded here so Insights can show their email (Terraform
# creates <project>-users). Empty = not recorded.
# USERS_TABLE=bap-users

# Server Configuration (optional)
# PORT=8000
# HOST=0.0.0.0

